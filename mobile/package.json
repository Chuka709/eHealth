  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "~19.3.0",
    "expo-doctor": "1.21.5",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "test": "jest --forceExit",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|use-intl|intl-messageformat|@formatjs/.*|@schummar/.*|@labtrack/.*|openapi-fetch|standard-navigation))"
    ]
  },
  "expo": {
    "install": {
      "exclude": [
        "expo",
        "expo-dev-client",
        "@expo/ui",
        "expo-file-system",
        "expo-router",
        "expo-web-browser",
        "jest-expo"
      ]
    }
  }
}
