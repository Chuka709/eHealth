{
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff*)",
      "Bash(uv run mypy*)",
      "Bash(uv run alembic*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(pnpm test*)",
      "Bash(pnpm lint*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm exec biome*)",
      "Bash(pnpm exec tsc*)",
      "Bash(docker compose up*)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose stop*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npx expo start*)",
      "Bash(npx expo-doctor*)",
      "Bash(eas build --profile development *)",
      "Bash(maestro test *)",
      "Bash(git push -u origin phase-*)",
      "Bash(git push origin phase-*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./eval/cases/**/raw/**)",
      "Read(./_archive/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/uv.lock)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push origin main*)",
      "Bash(git push *:main*)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push *--force-with-lease*)",
      "Bash(git push *+*)",
"Bash(git push *--no-verify*)",
      "Bash(git config *core.hooksPath*)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down *--volumes*)",
      "Bash(docker compose down *-v*)",
      "Bash(eas submit *)",
      "Bash(eas update --channel production *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "expo@expo-plugins": true
  }
}
