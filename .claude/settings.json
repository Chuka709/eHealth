{
  "env": {
    "ENABLE_STOP_REVIEW": "0"
  },
  "permissions": {
    "allow": [
      "Bash(just *)",
      "Bash(uv *)",
      "Bash(pnpm *)",
      "Bash(docker compose *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npx expo *)",
      "Bash(eas build --profile development *)",
      "Bash(maestro test *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./eval/cases/**/raw/**)",
      "Read(./_archive/**)",
      "Read(./**/node_modules/**)",
      "Read(./**/pnpm-lock.yaml)",
      "Read(./**/uv.lock)",
      "Bash(git push *)",
      "Bash(docker compose down -v*)",
      "Bash(eas submit *)",
      "Bash(eas update --channel production *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.mjs\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "expo@expo-plugins": true
  }
}
