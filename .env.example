# Copy is created by `just init` with random dev secrets. Never commit .env.
ENVIRONMENT=dev

# --- Postgres (superuser is used only by infra/postgres/init) ---
POSTGRES_PASSWORD=__generate__
LABTRACK_OWNER_PASSWORD=__generate__
LABTRACK_APP_PASSWORD=__generate__
LABTRACK_ADMIN_PASSWORD=__generate__
LABTRACK_MAINT_PASSWORD=__generate__

# --- Queue (Valkey) ---
VALKEY_PASSWORD=__generate__

# --- Dev entry point: 127.0.0.1 (default) or 0.0.0.0 to test from a phone on the LAN ---
CADDY_BIND=127.0.0.1

# --- Object storage (SeaweedFS S3 in dev) ---
S3_ACCESS_KEY=__generate__
S3_SECRET_KEY=__generate__
S3_BUCKET=labtrack-documents

# --- Crypto (dev only; production uses OpenBao transit) ---
LABTRACK_DEV_KEK=__generate_b64_32__

# --- External services (optional in dev) ---
SENTRY_DSN=
ANTHROPIC_API_KEY=
EXTRACTION_MODEL=
ESCALATION_MODEL=
