{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.expo",
      "!**/.next",
      "!**/dist",
      "!packages/shared/src/api/schema.d.ts",
      "!eval/cases",
      "!packages/shared/openapi.json",
      "!seed",
      "!_archive",
      "!backend",
      "!**/*.md",
      "!**/*.yaml",
      "!**/*.yml",
      "!**/.vscode",
      "!**/*.svg"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "recommended": true,
      "suspicious": {
        "noExplicitAny": "error"
      },
      "style": {
        "noDefaultExport": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": ["mobile/src/**", "!mobile/src/components/app-text.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "react-native": {
                    "importNames": ["Text"],
                    "message": "Use Text from @/components/app-text (the app font, 2.12)."
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
