#!/bin/sh
# Refuse pushes that would change main or rewrite history (no server-side branch protection on
# a private repository with GitHub Free, so this is the guard). Enable once per clone:
#   git config core.hooksPath .githooks
# main changes only through a pull request merged on GitHub.
#
# git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>

zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main | refs/heads/master)
      echo "pre-push: refusing to push to ${remote_ref#refs/heads/} - merge a pull request on GitHub instead." >&2
      status=1
      continue
      ;;
  esac
  # deleting a remote branch is not rewriting it
  [ "$local_sha" = "$zero" ] && continue
  # a new remote branch has nothing to overwrite
  [ "$remote_sha" = "$zero" ] && continue
  # the remote tip must be an ancestor of what we push (a fast-forward); anything else would
  # overwrite commits that are on the remote (a force push), or we have not fetched it yet
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
    echo "pre-push: refusing a non-fast-forward push to ${remote_ref#refs/heads/} (it would rewrite history). Fetch and merge instead." >&2
    status=1
  fi
done

exit $status
