{
  "name": "@labtrack/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./messages/mn.json": "./messages/mn.json",
    "./messages/en.json": "./messages/en.json",
    "./consent-versions.json": "./consent-versions.json",
    "./fixtures/dose-slots.json": "./fixtures/dose-slots.json"
  },
  "scripts": {
    "gen": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "7.13.0",
    "typescript": "~6.0.3"
  }
}
