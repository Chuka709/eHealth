{
  "openapi": "3.1.0",
  "info": {
    "title": "LabTrack MN API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/healthz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Healthz",
        "description": "Liveness: the process is up. No dependencies checked.",
        "operationId": "healthz_api_v1_healthz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/readyz": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readyz",
        "description": "Readiness: database and queue reachable. Error details are never returned.",
        "operationId": "readyz_api_v1_readyz_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "Health"
      },
      "Readiness": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status"
          },
          "database": {
            "type": "boolean",
            "title": "Database"
          },
          "queue": {
            "type": "boolean",
            "title": "Queue"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "queue"
        ],
        "title": "Readiness"
      }
    }
  }
}
