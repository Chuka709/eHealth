# Production environment (docs/SERVER_INSTALL_PLAN.md §4): copy to /etc/labtrack/labtrack.env
# (root, 0600) and fill in; `just prod-init` (S3) generates the passwords and secret files.
# Used with: docker compose -f infra/docker-compose.yml -f infra/docker-compose.prod.yml
#            --env-file /etc/labtrack/labtrack.env ...
# Secrets are NOT here: they are files in LABTRACK_SECRETS_DIR (list at the end).

# --- the build to run (git sha of the release) ---
LABTRACK_RELEASE=
LABTRACK_SECRETS_DIR=/etc/labtrack/secrets

# --- public entry (Caddy, Let's Encrypt; 80 and 443 reachable from outside) ---
LABTRACK_DOMAIN=
ACME_EMAIL=
# who may open /admin: Caddy (space-separated) and the API (JSON) - the same networks
ADMIN_ALLOWLIST=
ADMIN_ALLOWED_NETWORKS=
APP_DOWNLOAD_URL=
ORG_SUPPORT_PHONE=

# --- Postgres roles (Postgres's init reads these; letters and digits, 32+) ---
POSTGRES_PASSWORD=
LABTRACK_OWNER_PASSWORD=
LABTRACK_APP_PASSWORD=
LABTRACK_ADMIN_PASSWORD=
LABTRACK_ADMIN_LOGIN_PASSWORD=
LABTRACK_MAINT_PASSWORD=
LABTRACK_PUSH_PASSWORD=
LABTRACK_BACKUP_PASSWORD=
# 25% of RAM / 75% of RAM (8 GB beta server: 2GB / 6GB)
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB

# --- queue (Valkey) ---
VALKEY_PASSWORD=
VALKEY_AI_PASSWORD=

# --- documents (SeaweedFS S3): one access key per process; the secret keys are files ---
S3_BUCKET=labtrack-documents
S3_API_ACCESS_KEY=
S3_WORKER_ACCESS_KEY=
S3_MAINT_ACCESS_KEY=
S3_BACKUP_ACCESS_KEY=

# --- keys (OpenBao, SERVER_INSTALL_PLAN §3): role ids from `labtrack openbao-setup --out` ---
# the name on OpenBao's TLS certificate, and where it really is (the private network)
OPENBAO_HOSTNAME=
OPENBAO_UPSTREAM=
OPENBAO_API_ROLE_ID=
OPENBAO_WORKER_ROLE_ID=
OPENBAO_MAINT_ROLE_ID=

# --- backups (OPS_RUNBOOK §2): the age PUBLIC key only ---
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=35
# the backup disk (not inside the repository)
BACKUP_DIR=/srv/labtrack-backups

# --- optional ---
SENTRY_DSN=
PUSH_ENABLED=false
AI_EXTRACTION_ENABLED=false
AI_DAILY_DOCUMENTS=20
EXTRACTION_MODEL=

# Secret files in LABTRACK_SECRETS_DIR: folders root:root 0700 (nobody else on the host gets
# in), files 0444 - compose (not swarm) bind-mounts them as they are, and the app runs as
# uid 10001; each container sees only the files it is given:
#   jwt_private_key.pem          ES256 private key (PEM)
#   identity_pepper              16-60 characters
#   s3/api s3/worker s3/maint s3/backup   S3 secret keys (letters and digits)
#   openbao/api.secret_id openbao/worker.secret_id openbao/maint.secret_id   (openbao-setup)
#   openbao/ca.pem               the CA that signed OpenBao's certificate
#   expo_access_token            empty file until push is on
#   anthropic_api_key            empty file until reading by AI is on
