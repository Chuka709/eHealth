{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "record_lab_report",
  "description": "Лабораторийн баримтаас задалсан өгөгдөл. Лавлах ба критик хязгаар зөвхөн баримтаас. Зөвхөн бичигдсэн зүйл.",
  "type": "object",
  "required": [
    "document_language",
    "reports"
  ],
  "properties": {
    "document_language": {
      "type": "string",
      "enum": [
        "mn",
        "ru",
        "en",
        "mixed",
        "other"
      ]
    },
    "document_quality": {
      "type": "string",
      "enum": [
        "good",
        "fair",
        "poor"
      ],
      "description": "Зураг/скан уншигдах байдал"
    },
    "reports": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "required": [
          "results"
        ],
        "properties": {
          "lab_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "patient_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "patient_birth_date_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "patient_age_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "patient_sex_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "collected_date_raw": {
            "type": [
              "string",
              "null"
            ],
            "description": "Дээж авсан огноо, бичигдсэнээр"
          },
          "collected_date_iso": {
            "type": [
              "string",
              "null"
            ],
            "description": "YYYY-MM-DD эсвэл YYYY-MM-DDTHH:mm, тодорхой бол л"
          },
          "reported_date_raw": {
            "type": [
              "string",
              "null"
            ]
          },
          "date_ambiguous": {
            "type": "boolean"
          },
          "panel_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Жишээ: Цусны ерөнхий шинжилгээ, Биохими"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "raw_name",
                "raw_value",
                "confidence"
              ],
              "properties": {
                "raw_name": {
                  "type": "string"
                },
                "raw_value": {
                  "type": "string"
                },
                "value_numeric": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "description": "Зөвхөн туслах утга (JSON number = float). Хадгалах утгыг labtrack.core нь raw_value-аас Decimal-аар дахин задлана; зөрвөл issue."
                },
                "comparator": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "<",
                    "<=",
                    ">",
                    ">=",
                    null
                  ]
                },
                "raw_unit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "ref_text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Тухайн мөрийн лавлах хязгаар яг бичигдсэнээр. Хүйс/насаар олон бол бүгдийг хуулж, ref_low/high-г null үлдээ"
                },
                "ref_low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "ref_high": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "critical_text": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Баримт дээрх критик/panic хязгаарын эх текст"
                },
                "critical_low": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "critical_high": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "lab_flag": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Баримт дээрх H, L, ↑, ↓, *, ! гэх мэт тэмдэг"
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "source_snippet": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200,
                  "description": "Тухайн мөрийн эх текст"
                },
                "confidence": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              }
            }
          },
          "notes": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          },
          "critical_legend": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2000,
            "description": "Баримтын ерөнхий критик утгын жагсаалт/тайлбар (тестийн мөрөнд биш, тусдаа хэсэгт бичигдсэн бол)"
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Уншихад хүндрэлтэй хэсэг, тасарсан хуудас гэх мэт"
    }
  }
}