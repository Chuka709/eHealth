{
	admin off
	auto_https off
}

# Dev entry point. Production adds TLS, HSTS and CSP (docs/04 §4).
:8080 {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	log {
		format filter {
			# No tokens, cookies or referrers in access logs (docs/04 §6.7):
			# query strings are cut, request and response headers are dropped entirely.
			fields {
				request>uri regexp "\?.*$" "?[redacted]"
				request>headers delete
				resp_headers delete
			}
		}
	}
	# Readiness exposes dependency state - for container healthchecks only, never public.
	# (`handle` blocks are exclusive and run before a bare `respond`, so it must be a handle too.)
	@internal path /api/v1/readyz
	handle @internal {
		respond 404
	}
	# docs/04 §1: the admin API and the admin web pages only from allowlisted networks (the
	# API checks again).
	# ADMIN_ALLOWLIST: space-separated CIDRs; dev default = loopback/private ranges.
	# Production: set it explicitly (no default), and behind a load balancer match on the
	# real client address (trusted_proxies), not the balancer's private IP.
	@admin_outside {
		path /api/v1/admin /api/v1/admin/* /admin /admin/*
		not remote_ip {$ADMIN_ALLOWLIST:private_ranges}
	}
	handle @admin_outside {
		respond 404
	}
	handle /api/* {
		# JSON bodies are small (the CSV import is <= 1 MB; documents go straight to storage
		# in Phase 3): a bigger body never reaches the API's parser.
		request_body {
			max_size 2MB
		}
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000 {
			# the admin's real address for the BFF (docs/04 §6.1); replaces any client value
			header_up X-LabTrack-Client-IP {client_ip}
		}
	}
}
