{
	admin off
	auto_https off
}

# Dev entry point. Production adds TLS, HSTS, CSP and the /admin IP allowlist (docs/04 §4).
:8080 {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
	}
	log {
		format filter {
			# No tokens, cookies or referrers in access logs (docs/04 §6.7):
			# query strings are cut, request and response headers are dropped entirely.
			fields {
				request>uri regexp "\?.*$" "?[redacted]"
				request>headers delete
				resp_headers delete
			}
		}
	}
	# Readiness exposes dependency state - for container healthchecks only, never public.
	# (`handle` blocks are exclusive and run before a bare `respond`, so it must be a handle too.)
	@internal path /api/v1/readyz
	handle @internal {
		respond 404
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy web:3000
	}
}
